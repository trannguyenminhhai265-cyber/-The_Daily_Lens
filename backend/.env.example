# Copy this file to .env and adjust values.

PORT=5000
NODE_ENV=development

# MongoDB connection string.
# Leave empty for local development: an embedded MongoDB is downloaded and started
# automatically (data persists in backend/.mongo-data).
# For hosting use MongoDB Atlas, e.g.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/newsportal?retryWrites=true&w=majority
MONGODB_URI=

# Port used by the embedded MongoDB when MONGODB_URI is empty.
EMBEDDED_DB_PORT=27018

# Secret used to sign JWT access tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma separated list of allowed origins for CORS (only needed when the frontend
# is served from a different origin than the API).
CORS_ORIGIN=http://localhost:5173

# Seed the database automatically on start-up when it contains no documents.
AUTO_SEED=true

# Optional: password for the seeded "admin" account (defaults to Admin@123).
SEED_ADMIN_PASSWORD=
