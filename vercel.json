{
  "buildCommand": "bun run build",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!api/|assets/|robots.txt).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/search.js": { "maxDuration": 15 },
    "api/admin/index-document.js": { "maxDuration": 60 }
  },
  "installCommand": "bun install --frozen-lockfile"
}
