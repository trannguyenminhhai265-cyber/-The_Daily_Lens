# Server-side only (Vercel project env vars / local .env). Never prefix these with VITE_ and never commit real values.
GEMINI_API_KEY=your-gemini-api-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Global ceiling of vector searches per UTC day (soft: counted per serverless instance). Default 500.
SEARCH_DAILY_CAP=500
# Optional: vector searches per minute per IP (default 20).
# SEARCH_RATE_PER_MIN=20

# Browser-safe values live in frontend/.env (see frontend), e.g. VITE_SUPABASE_URL, VITE_SUPABASE_PUBLISHABLE_KEY.
